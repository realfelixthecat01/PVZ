<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>PVZLauncher</AssemblyName>
    <RootNamespace>PVZ.Launcher</RootNamespace>
    <ApplicationIcon>..\PVZT\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup>
    <PublishSelfContained>true</PublishSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PVZP\PVZP.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Сервер PVZS запаковывается внутрь лаунчера: один exe на машине, данные — рядом с ним. -->
    <ServerProject>$(MSBuildThisFileDirectory)..\PVZS\PVZS.csproj</ServerProject>
    <StudentProject>$(MSBuildThisFileDirectory)..\PVZP\PVZP.csproj</StudentProject>
    <TeacherProject>$(MSBuildThisFileDirectory)..\PVZT\PVZT.csproj</TeacherProject>
    <_ServerRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_ServerRid>
    <_ServerRid Condition="'$(_ServerRid)' == '' and '$(PublishRuntimeIdentifier)' != ''">$(PublishRuntimeIdentifier)</_ServerRid>
    <_ServerRid Condition="'$(_ServerRid)' == ''">win-x64</_ServerRid>
    <_ServerPublishDir>$(MSBuildThisFileDirectory)..\PVZS\bin\$(Configuration)\net10.0\$(_ServerRid)\publish\</_ServerPublishDir>
    <_ServerBuildDir>$(MSBuildThisFileDirectory)..\PVZS\bin\$(Configuration)\net10.0\</_ServerBuildDir>
    <_StudentPublishDir>$(MSBuildThisFileDirectory)..\PVZP\bin\$(Configuration)\net10.0-windows\$(_ServerRid)\publish\</_StudentPublishDir>
    <_TeacherPublishDir>$(MSBuildThisFileDirectory)..\PVZT\bin\$(Configuration)\net10.0-windows\$(_ServerRid)\publish\</_TeacherPublishDir>
  </PropertyGroup>

  <!-- dotnet publish: ��������� PVZS.exe � ������ PVZP/PVZT � �������� � exe. -->
  <Target Name="BundleServerTemplate" BeforeTargets="_ComputeFilesToBundle">
    <MSBuild
      Projects="$(ServerProject)"
      Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(_ServerRid);SelfContained=true;PublishSingleFile=true;PublishDir=$(_ServerPublishDir);PublishProfile=" />
    <MSBuild
      Projects="$(StudentProject)"
      Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(_ServerRid);SelfContained=true;PublishSingleFile=true;PublishProfile=" />
    <MSBuild
      Projects="$(TeacherProject)"
      Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(_ServerRid);SelfContained=true;PublishSingleFile=true;PublishProfile=" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(_ServerPublishDir)PVZS.exe">
        <RelativePath>ServerTemplate\PVZS.exe</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(_StudentPublishDir)PVZP.exe">
        <RelativePath>ClientTemplate\PVZP.exe</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(_TeacherPublishDir)PVZT.exe">
        <RelativePath>ClientTemplate\PVZT.exe</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- dotnet build: сервер собирается и копируется в server\ рядом с лаунчером для отладки. -->
  <Target Name="CopyServerTemplate" AfterTargets="Build" Condition="'$(IsPublishing)' != 'true'">
    <MSBuild Projects="$(ServerProject)" Targets="Build" Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <_ServerBuildFiles Include="$(_ServerBuildDir)**\*" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)server" />
    <Copy
      SourceFiles="@(_ServerBuildFiles)"
      DestinationFiles="@(_ServerBuildFiles->'$(OutDir)server\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
